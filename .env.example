# Placeholder environment values for local development.
# ASP.NET Core does not automatically read .env files. Export these variables
# in the API process environment or enter them in your IDE launch configuration.

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5273

# Comma-separated array binding for the origins allowed to call public widget endpoints.
PublicSubmission__AllowedOrigins__0=http://localhost:8000
PublicSubmission__AllowedOrigins__1=http://localhost:3000

# Local evaluation defaults. Tune these values for your test scenario.
RateLimiting__PermitLimit=10
RateLimiting__WindowSeconds=60

# Leave the lookup URL empty to disable external IP geo lookup.
# Production lookup URLs must use HTTPS.
Geo__IpLookupBaseUrl=

# Only list proxy IP addresses that are trusted to provide the CF-IP* headers.
Geo__TrustedProxyAddresses__0=
